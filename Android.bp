//
// The x-kernel VM control service: the only owner of the x-kernel VM, created through AVF as a
// protected VM without guest firmware, controlled by clients over IXKernelVmControl.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "com.kylinos.xkernelvm",
    srcs: ["aidl/com/kylinos/xkernelvm/*.aidl"],
    local_include_dir: "aidl",
    // Used only between this service, its shell client and the control app, all built from the
    // same tree and installed in system_ext together.
    unstable: true,
    system_ext_specific: true,
    backend: {
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
        java: {
            enabled: true,
            platform_apis: true,
        },
        rust: {
            enabled: true,
        },
    },
}

rust_defaults {
    name: "xkernel_vm_service_defaults",
    crate_name: "xkernel_vm_service",
    srcs: ["src/main.rs"],
    edition: "2021",
    prefer_rlib: true,
    rustlibs: [
        "android.os.permissions_aidl-rust",
        "android.system.virtualizationservice-rust",
        "com.kylinos.xkernelvm-rust",
        "libandroid_logger",
        "libanyhow",
        "libbinder_rs",
        "libclap",
        "liblibc",
        "liblog_rust",
        "libnix",
        "librustutils",
        "libserde",
        "libserde_json",
        "libvmclient",
    ],
}

rust_binary {
    name: "xkernel_vm_service",
    defaults: ["xkernel_vm_service_defaults"],
    system_ext_specific: true,
    init_rc: ["etc/init/xkernel_vm_service.rc"],
    required: [
        "xkernel_crosvm_launcher",
        "xkernel_vm.json",
        "xkernel_vm_loader",
        "xkernel_vm_modules.load",
    ],
}

// Starts the direct backend's crosvm so that it dies with the service (launcher/main.rs).
rust_binary {
    name: "xkernel_crosvm_launcher",
    crate_name: "xkernel_crosvm_launcher",
    srcs: ["launcher/main.rs"],
    edition: "2021",
    prefer_rlib: true,
    system_ext_specific: true,
    rustlibs: ["liblibc"],
}

// Loads the hypervisor's host driver when the service asks (loader/main.rs).
rust_binary {
    name: "xkernel_vm_loader",
    crate_name: "xkernel_vm_loader",
    srcs: ["loader/main.rs"],
    edition: "2021",
    prefer_rlib: true,
    system_ext_specific: true,
    rustlibs: [
        "libandroid_logger",
        "liblibc",
        "liblog_rust",
        "librustutils",
    ],
}

// The load order of the driver's modules. The .ko files themselves come with the driver build
// (they must match the device's kernel) and go into the same directory,
// /system_ext/etc/xkernel_vm/modules.
prebuilt_etc {
    name: "xkernel_vm_modules.load",
    src: "etc/modules.load",
    filename: "modules.load",
    system_ext_specific: true,
    relative_install_path: "xkernel_vm/modules",
}

rust_test {
    name: "xkernel_vm_service_test",
    defaults: ["xkernel_vm_service_defaults"],
    test_suites: ["general-tests"],
}

rust_binary {
    name: "xkernel_vmctl",
    crate_name: "xkernel_vmctl",
    srcs: ["ctl/main.rs"],
    edition: "2021",
    prefer_rlib: true,
    system_ext_specific: true,
    rustlibs: [
        "com.kylinos.xkernelvm-rust",
        "libanyhow",
        "libbinder_rs",
        "libclap",
        "libnix",
    ],
}

// The instance config: the direct backend (preferred). A product that runs the VM through AVF
// takes etc/xkernel_vm.avf.json as src instead and adds the declaration below.
prebuilt_etc {
    name: "xkernel_vm.json",
    src: "etc/xkernel_vm.json",
    system_ext_specific: true,
    relative_install_path: "xkernel_vm",
}

// Read by virtmgr, AVF backend only: the x-kernel VM may only be run by
// /system_ext/bin/xkernel_vm_service, as a protected VM without guest firmware.
prebuilt_etc {
    name: "protected_vms_without_firmware_xkernel.xml",
    src: "etc/avf/protected_vms_without_firmware_xkernel.xml",
    system_ext_specific: true,
    relative_install_path: "avf",
}
