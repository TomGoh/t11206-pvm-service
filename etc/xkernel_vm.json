{
  "name": "xkernel_vm",
  "kernel": "/system_ext/etc/xkernel_vm/kernel.bin",
  "params": "panic=-1 console=ttyS0 loglevel=8",
  "memory_mib": 256,
  "cpus": 2,
  "protection": "without_firmware",
  "disks": [
    { "path": "/system_ext/etc/xkernel_vm/dummy.img", "writable": false },
    { "path": "/data/misc/xkernel_vm/rootfs.img", "writable": true }
  ],
  "state_dir": "/data/misc/xkernel_vm",
  "console_input_device": "ttyS0",
  "readiness": { "console_marker": "kylin-x:~#", "timeout_seconds": 60 },
  "stop_timeout_seconds": 30,
  "reclaim_window_seconds": 10,
  "backend": "direct",
  "direct": {
    "crosvm": "/system_ext/bin/xkernel_crosvm",
    "launcher": "/system_ext/bin/xkernel_crosvm_launcher",
    "cid": 1024
  },
  "driver": { "timeout_seconds": 20 }
}
