# The x-kernel VM control service. It owns no VM until a client asks for a start, so it runs
# from boot completion on; it is small and idle while the VM is stopped.
service xkernel_vm_service /system_ext/bin/xkernel_vm_service
    class main
    # crosvm runs with this service's identity and opens /dev/xhyper: the vendor's ueventd rule
    # makes it 0666 like /dev/kvm, and SELinux lets only the crosvm domain open it
    # (vendor/README.md). No capabilities.
    user system
    group system virtualmachine
    # The hypervisor driver pins the guest's memory against the locked-memory limit (8 MiB by
    # default; a 256 MiB guest then fails at its first run). crosvm inherits this one.
    rlimit memlock unlimited unlimited
    disabled

on post-fs-data
    mkdir /data/misc/xkernel_vm 0770 root system

on property:sys.boot_completed=1
    start xkernel_vm_service
