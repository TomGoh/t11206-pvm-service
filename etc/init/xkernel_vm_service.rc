# The x-kernel VM control service. It owns no VM until a client asks for a start, so it runs
# from boot completion on; it is small and idle while the VM is stopped.
service xkernel_vm_service /system_ext/bin/xkernel_vm_service
    class main
    # /dev/xhyper is root-only; crosvm runs with this service's identity.
    user root
    group system virtualmachine
    capabilities IPC_LOCK NET_BIND_SERVICE SYS_RESOURCE SYS_NICE
    disabled

on post-fs-data
    mkdir /data/misc/xkernel_vm 0770 root system

on property:sys.boot_completed=1
    start xkernel_vm_service
