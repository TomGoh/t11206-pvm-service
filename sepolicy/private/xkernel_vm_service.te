# The x-kernel VM control service (/system_ext/bin/xkernel_vm_service).
type xkernel_vm_service, domain, coredomain;
type xkernel_vm_service_exec, system_file_type, exec_type, file_type;
init_daemon_domain(xkernel_vm_service)

# The service's Binder interface, used by the control app and the shell client.
type xkernel_vm_control_service, service_manager_type;
binder_use(xkernel_vm_service)
add_service(xkernel_vm_service, xkernel_vm_control_service)
binder_call(xkernel_vm_service, platform_app)
allow platform_app xkernel_vm_control_service:service_manager find;
binder_call(platform_app, xkernel_vm_service)

# Callers other than root and system are checked against the control permission.
allow xkernel_vm_service permission_service:service_manager find;
binder_call(xkernel_vm_service, system_server)

# A client of AVF: spawns its own virtmgr and passes it the VM images.
virtualizationservice_use(xkernel_vm_service)
get_prop(xkernel_vm_service, hypervisor_prop)

# Instance ID, writable disk and the record of the running instance.
type xkernel_vm_data_file, file_type, data_file_type, core_data_file_type;
allow xkernel_vm_service xkernel_vm_data_file:dir create_dir_perms;
allow xkernel_vm_service xkernel_vm_data_file:file create_file_perms;

# The reclaim check reads /proc/<pid>/{cmdline,stat} of the VM's crosvm.
r_dir_file(xkernel_vm_service, crosvm)
r_dir_file(xkernel_vm_service, virtualizationmanager)
# To find a crosvm_<name> process it scans every /proc entry. A crosvm only ever runs in the crosvm
# domain, readable above, so the scan skips other domains' entries; this keeps it out of the log.
dontaudit xkernel_vm_service domain:dir search;
dontaudit xkernel_vm_service domain:file { read open getattr };

# The serial console: the service creates the pipes and passes the guest ends to its virtmgr,
# which hands them to crosvm (as AVF's own clients such as CompOS do).
allow { crosvm virtualizationmanager } xkernel_vm_service:fd use;
allow { crosvm virtualizationmanager } xkernel_vm_service:fifo_file { getattr ioctl read write };

# The direct backend: the service runs the product's crosvm build with the hypervisor's backend
# (/system_ext/bin/xkernel_crosvm) itself. Platform policy lets only the crosvm domain open
# kvm_device (/dev/vhost-vsock) and, among core domains, the VM manager devices (/dev/xhyper once
# vendor policy gives it a vm_manager_device_type), and lets only virtmgr execute AVF's
# crosvm_exec; so the build has its own exec type and runs in AVF's crosvm domain. The same
# executable serves `crosvm stop <socket>`, which the service runs to ask the VM to exit.
type xkernel_crosvm_exec, system_file_type, exec_type, file_type;
domain_auto_trans(xkernel_vm_service, xkernel_crosvm_exec, crosvm)
# Killing a crosvm that ignores the stop request; also the parent-death signal.
allow xkernel_vm_service crosvm:process { sigkill signal };

# crosvm's stdin and stdout are the console pipes, reopened through /proc/self/fd for its serial
# devices; its stderr is state_dir/crosvm.log, opened by the service.
allow crosvm xkernel_vm_service:fifo_file open;
# Asking whether stdin is a terminal (TCGETS2) only ever answers "no" on a pipe; any other ioctl on
# the pipes stays refused (domain.te already limits them to FIOCLEX and FIONCLEX).
allowxperm crosvm xkernel_vm_service:fifo_file ioctl 0x542a;
allow crosvm xkernel_vm_data_file:file { getattr append write ioctl };

# It opens the instance's writable disks by path and creates its control socket in state_dir,
# where the stopping crosvm connects to it.
allow crosvm xkernel_vm_data_file:dir { search getattr write add_name remove_name };
allow crosvm xkernel_vm_data_file:file { open read lock map };
allow crosvm xkernel_vm_data_file:sock_file { create unlink getattr setattr write };
# Before a start the service removes the socket a crashed crosvm may have left.
allow xkernel_vm_service xkernel_vm_data_file:sock_file { getattr unlink };
allow crosvm self:unix_stream_socket { create_stream_socket_perms connectto };

# No vsock for the service itself: platform policy lets only AVF's managers, adbd and traced
# create or connect vsock sockets (system/sepolicy private/domain.te), so the direct backend's
# readiness handshake cannot be a vsock connection from this service under enforcing SELinux.
