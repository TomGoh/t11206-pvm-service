// Copy to $(XKERNEL_VM_PREBUILTS_DIR)/Android.bp, next to the prebuilt files (product/README.md of
// t11206-pvm-service). It turns the one prebuilt that needs a module into a module: the crosvm
// build with the hypervisor's backend (an ELF under bin). product.mk puts it in PRODUCT_PACKAGES
// and copies the plain files (driver modules, guest images) itself.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// /system_ext/bin/xkernel_crosvm, the path etc/xkernel_vm.json names and the service's
// file_contexts labels. Statically linked: installed as delivered.
cc_prebuilt_binary {
    name: "xkernel_crosvm",
    srcs: ["xkernel_crosvm"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
    system_ext_specific: true,
}
