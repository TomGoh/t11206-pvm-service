# The x-kernel VM package as built files (binary delivery), generated by make-drop.sh of
# t11206-pvm-service. Include it from the product makefile:
#
#   $(call inherit-product, <path of this directory>/product.mk)
#
# This directory is self-contained: the built service programs and control app, the init script,
# the instance config, the SELinux policy sources, crosvm with the hypervisor's backend, the host
# driver's modules and the x-kernel guest images. MANIFEST.txt says where each file comes from.
# The source repositories must not be in the same tree (duplicate modules). The monitor app is
# imported like the product's other Kylin apps (product/monitor of t11206-pvm-service).
XKERNEL_VM_DROP_DIR := $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST))))

PRODUCT_PACKAGES += \
    xkernel_vm_service \
    xkernel_vm.json \
    XKernelVmControl \
    xkernel_crosvm

# The shell client, for debugging builds only.
PRODUCT_PACKAGES_DEBUG += xkernel_vmctl

# The policy is delivered as sources: the build compiles it with the platform policy and checks it
# against every neverallow.
SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(XKERNEL_VM_DROP_DIR)/sepolicy/private

# Generated from etc/modules.load.
XKERNEL_VM_MODULES := @MODULES@

# Plain files under etc (the ELF check of PRODUCT_COPY_FILES covers bin and lib paths only).
PRODUCT_COPY_FILES += \
    $(foreach m,$(XKERNEL_VM_MODULES),$(XKERNEL_VM_DROP_DIR)/modules/$(m):$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/xkernel_vm/modules/$(m)) \
    $(foreach f,kernel.bin dummy.img rootfs.img,$(XKERNEL_VM_DROP_DIR)/$(f):$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/xkernel_vm/$(f))
