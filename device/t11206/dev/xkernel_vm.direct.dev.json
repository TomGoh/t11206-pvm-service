{
  "name": "xkernel_vm",
  "kernel": "/data/local/tmp/xkernel-pvm/vm/kernel.bin",
  "params": "panic=-1 console=ttyS0 loglevel=8",
  "memory_mib": 256,
  "cpus": 2,
  "protection": "without_firmware",
  "disks": [
    {
      "path": "/data/local/tmp/xkernel-pvm/vm/dummy.img",
      "writable": true
    },
    {
      "path": "/data/local/tmp/xkernel-pvm/vm/rootfs.img",
      "writable": true
    }
  ],
  "state_dir": "/data/local/tmp/xkernel-pvm/state-direct",
  "console_input_device": "ttyS0",
  "stop_timeout_seconds": 30,
  "reclaim_window_seconds": 10,
  "backend": "direct",
  "direct": {
    "crosvm": "/data/local/tmp/xhyper-new/crosvm-xhyper",
    "cid": 1024
  }
}
